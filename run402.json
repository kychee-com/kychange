{
  "$schema": "https://run402.com/schemas/release-spec.v1.json",
  "database": {
    "migrations": [
      {
        "id": "001_swaps",
        "sql_path": "db/001_swaps.sql"
      },
      {
        "id": "002_route_a",
        "sql_path": "db/002_route_a.sql"
      }
    ]
  },
  "functions": {
    "replace": {
      "quote": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 10,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/quote.mjs"
        }
      },
      "swap-sats-in": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 10,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/swap-sats-in.mjs"
        }
      },
      "swap-status": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 10,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/swap-status.mjs"
        }
      },
      "payout-usdc": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 30,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/payout-usdc.mjs"
        }
      },
      "swap-usdc-in": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 10,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/swap-usdc-in.mjs"
        }
      },
      "payout-sats": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 30,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/payout-sats.mjs"
        }
      },
      "refund-usdc": {
        "runtime": "node22",
        "config": {
          "timeout_seconds": 30,
          "memory_mb": 128
        },
        "source": {
          "path": "dist/refund-usdc.mjs"
        }
      }
    }
  },
  "routes": {
    "replace": [
      {
        "pattern": "/api/quote",
        "methods": [
          "GET"
        ],
        "target": {
          "type": "function",
          "name": "quote"
        }
      },
      {
        "pattern": "/api/swaps/*",
        "methods": [
          "GET"
        ],
        "target": {
          "type": "function",
          "name": "swap-status"
        }
      },
      {
        "pattern": "/api/usdc/100",
        "methods": [
          "POST"
        ],
        "target": {
          "type": "function",
          "name": "swap-sats-in"
        },
        "pricing": {
          "mode": "always",
          "amount_usd_micros": 100000,
          "amount_msat": 100000,
          "pay_to": "org_default_payout",
          "networks": [
            "lightning-testnet"
          ],
          "discovery": {
            "description": "Swap 100 sats on Bitcoin Lightning into USDC on Base: pay this route over x402 exact on lnbtc (the invoice is bound to the request), name a Base address, and the desk pays the USDC leg at the index price minus the spread. Testnet instance: Lightning testnet3 in, Base Sepolia USDC out (demo-mode payout).",
            "service_name": "kychange",
            "tags": [
              "swap",
              "lightning",
              "usdc"
            ],
            "input": {
              "body_type": "json",
              "body_schema": {
                "type": "object",
                "required": [
                  "destination"
                ],
                "properties": {
                  "destination": {
                    "type": "string",
                    "description": "An EVM address on Base that receives the USDC"
                  },
                  "quote_id": {
                    "type": "string",
                    "description": "Optional quote_id from GET /api/quote"
                  }
                }
              },
              "example": {
                "destination": "0x0000000000000000000000000000000000000000"
              }
            },
            "output": {
              "example": {
                "swap_id": "swp_…",
                "state": "payout_pending",
                "sats_in": 100,
                "usd_out": "$0.08",
                "status_url": "https://kychange.com/api/swaps/swp_…?claim=clm_…"
              }
            }
          }
        }
      },
      {
        "pattern": "/api/usdc/10k",
